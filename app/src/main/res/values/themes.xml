<resources>
    <style name="Theme.Flux.Base" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="shadowGlass">?attr/colorSurface</item>
        <item name="shadowGlassStrong">?attr/colorSurfaceVariant</item>
        <item name="shadowGlow">@android:color/transparent</item>
        <item name="shadowScrim">@color/scrim_dark</item>
        <item name="fluxLevel0">@color/flux_level_0</item>
        <item name="fluxLevel1">@color/flux_level_1</item>
        <item name="fluxLevel2">@color/flux_level_2</item>
        <item name="fluxLevel3">@color/flux_level_3</item>
        <item name="fluxLevel4">@color/flux_level_4</item>
        <item name="fluxToday">@color/flux_today</item>
        <item name="doomsdayActive">?attr/colorPrimary</item>
        <item name="doomsdayInactive">?attr/colorSurfaceVariant</item>
        <item name="fluxRingFocus">@color/flux_ring_focus</item>
        <item name="fluxRingStreak">@color/flux_ring_streak</item>
        <item name="fluxRingTasks">@color/flux_ring_tasks</item>
        <item name="fluxRingHours">@color/flux_ring_hours</item>
        <item name="fluxRingTrack">@color/flux_ring_track</item>
        <item name="fluxGlassBackground">@color/flux_glass_background</item>
        <item name="fluxGlassStroke">@color/flux_glass_stroke</item>
        <item name="fluxAuraPrimary">@color/flux_aura_primary</item>
        <item name="fluxAuraSecondary">@color/flux_aura_secondary</item>
        <item name="fluxCommandBarBackground">@color/flux_command_bar_background</item>
    </style>

    <style name="Theme.Flux.Dark" parent="Theme.Flux.Base">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/brand_surface</item>
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="android:colorBackground">@color/brand_surface</item>
        <item name="colorSurface">@color/brand_surface_raised</item>
        <item name="colorOnSurface">@color/brand_on_surface</item>
        <item name="colorSurfaceVariant">@color/brand_surface_overlay</item>
        <item name="colorOnSurfaceVariant">@color/brand_on_surface_muted</item>
        <item name="colorOutline">@color/brand_outline</item>
        <item name="colorError">@color/brand_error</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="shadowScrim">@color/scrim_dark</item>
        <item name="doomsdayActive">@color/brand_primary</item>
        <item name="doomsdayInactive">@color/brand_surface_overlay</item>
    </style>

    <style name="Theme.Flux.Light" parent="Theme.Flux.Base">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="android:colorBackground">@color/md_light_background</item>
        <item name="colorSurface">@color/md_light_surface</item>
        <item name="colorOnSurface">@color/md_light_on_surface</item>
        <item name="colorSurfaceVariant">@color/md_light_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/md_light_on_surface_variant</item>
        <item name="colorOutline">@color/md_light_outline</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="shadowScrim">@color/scrim_light</item>
        <item name="doomsdayActive">@color/brand_primary</item>
        <item name="doomsdayInactive">#1A000000</item>
    </style>

    <style name="Theme.Flux" parent="Theme.Flux.Dark" />
</resources>
