<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ========================= -->
    <!-- Main Launcher Theme -->
    <!-- ========================= -->
    <style name="Theme.Shadow" parent="android:Theme.DeviceDefault.NoActionBar">
        <!-- Identity: silence & negative space -->
        <item name="android:windowBackground">@android:color/black</item>

        <!-- No bars, no chrome -->
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>

        <!-- Status & navigation bars blend into void -->
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>

        <!-- No transitions = no stimulation -->
        <item name="android:windowAnimationStyle">@null</item>
    </style>


    <!-- ========================= -->
    <!-- Delay Overlay Theme -->
    <!-- ========================= -->
    <style name="Theme.Shadow.Delay" parent="android:Theme.DeviceDefault.NoActionBar">
        <!-- Semi-transparent pause -->
        <item name="android:windowBackground">@android:color/transparent</item>

        <!-- Overlay behavior -->
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>

        <!-- Dim the world slightly -->
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.35</item>

        <!-- No animation = no reward -->
        <item name="android:windowAnimationStyle">@null</item>

        <!-- System bars stay dark -->
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

</resources>