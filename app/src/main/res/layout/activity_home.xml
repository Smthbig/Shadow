<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/background_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="56dp"
            android:paddingBottom="32dp"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <!-- Clock -->
                <TextClock
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="hh:mm"
                    android:format24Hour="HH:mm"
                    android:textSize="56sp"
                    android:textColor="?attr/colorOnSurface"
                    android:fontFamily="sans-serif-thin"
                    android:letterSpacing="-0.02" />

                <!-- Date -->
                <TextView
                    android:id="@+id/date_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:letterSpacing="0.06"
                    android:layout_marginTop="4dp" />

                <!-- Greeting -->
                <TextView
                    android:id="@+id/greeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginTop="20dp"
                    android:alpha="0.5" />

                <!-- Intention + Goal Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/goal_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginTop="20dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/colorOutline"
                    app:cardBackgroundColor="?attr/colorSurface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Top row: label + progress text -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/goal_label"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/today_goal_label"
                                android:textSize="10sp"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:letterSpacing="0.1"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:id="@+id/goal_progress_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="10sp"
                                android:textColor="?attr/colorSecondary"
                                android:fontFamily="sans-serif-medium"
                                android:text="0 / 120 min" />
                        </LinearLayout>

                        <!-- Intention -->
                        <TextView
                            android:id="@+id/intention_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="15sp"
                            android:textColor="?attr/colorOnSurface"
                            android:layout_marginTop="8dp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif"
                            android:textStyle="bold"
                            android:background="?attr/selectableItemBackground"
                            android:paddingVertical="2dp"
                            android:paddingHorizontal="2dp"
                            android:gravity="start" />

                        <!-- Progress bar -->
                        <LinearLayout
                            android:id="@+id/progress_section"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="10dp">

                            <ProgressBar
                                android:id="@+id/goal_progress"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="3dp"
                                android:max="100"
                                android:progress="0"
                                android:progressTint="?attr/colorSecondary"
                                android:progressBackgroundTint="?attr/colorSurfaceVariant" />

                            <TextView
                                android:id="@+id/goal_minutes_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="10sp"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:layout_marginTop="3dp"
                                android:alpha="0.5"
                                android:text="0% of daily goal" />
                        </LinearLayout>

                        <!-- Timer -->
                        <LinearLayout
                            android:id="@+id/timer_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="10dp">

                            <TextView
                                android:id="@+id/timer_display"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="22sp"
                                android:textColor="?attr/colorPrimary"
                                android:fontFamily="sans-serif-medium"
                                android:text="25:00" />

                            <TextView
                                android:id="@+id/timer_label"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="focus"
                                android:textSize="12sp"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:layout_marginStart="6dp"
                                android:alpha="0.5" />

                            <ImageButton
                                android:id="@+id/timer_btn"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:padding="6dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:alpha="0.7"
                                android:scaleType="centerInside" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Stats Row -->
                <LinearLayout
                    android:id="@+id/stats_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <LinearLayout
                        android:id="@+id/stat_focus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingVertical="8dp">

                        <TextView
                            android:id="@+id/stat_focus_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="18sp"
                            android:textColor="?attr/colorOnSurface"
                            android:fontFamily="sans-serif-medium"
                            android:text="0" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="10sp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:text="@string/stats_focus"
                            android:alpha="0.5"
                            android:layout_marginTop="1dp" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="24dp"
                        android:background="?attr/colorOutline"
                        android:alpha="0.2" />

                    <LinearLayout
                        android:id="@+id/stat_sessions"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingVertical="8dp">

                        <TextView
                            android:id="@+id/stat_sessions_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="18sp"
                            android:textColor="?attr/colorOnSurface"
                            android:fontFamily="sans-serif-medium"
                            android:text="0" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="10sp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:text="@string/stats_sessions"
                            android:alpha="0.5"
                            android:layout_marginTop="1dp" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="24dp"
                        android:background="?attr/colorOutline"
                        android:alpha="0.2" />

                    <LinearLayout
                        android:id="@+id/stat_blocks"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingVertical="8dp">

                        <TextView
                            android:id="@+id/stat_blocks_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="18sp"
                            android:textColor="?attr/colorOnSurface"
                            android:fontFamily="sans-serif-medium"
                            android:text="0" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="10sp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:text="@string/stats_blocked"
                            android:alpha="0.5"
                            android:layout_marginTop="1dp" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- Contribution Grid -->
            <com.smthbig.shadow.launcher.home.ContributionView
                android:id="@+id/contribution_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginBottom="8dp" />

            <!-- Search -->
            <TextView
                android:id="@+id/search_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/search_hint"
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:alpha="0.35"
                android:letterSpacing="0.06"
                android:paddingHorizontal="20dp"
                android:paddingVertical="10dp"
                android:background="?attr/selectableItemBackground"
                android:drawablePadding="6dp"
                android:drawableStart="@android:drawable/ic_menu_search"
                android:drawableTint="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

        <!-- Settings -->
        <ImageView
            android:id="@+id/settings_btn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="10dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_settings_gear"
            app:tint="?attr/colorOnSurfaceVariant"
            android:layout_gravity="top|end"
            android:alpha="0.4" />

    </FrameLayout>

    <View
        android:id="@+id/blur_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/shadowScrim"
        android:alpha="0"
        android:visibility="gone"
        android:elevation="10dp" />

    <com.smthbig.shadow.launcher.home.IntentBarView
        android:id="@+id/intent_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="16dp"
        android:visibility="gone"
        android:elevation="30dp" />

</FrameLayout>
