<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- BASE DARK BACKGROUND -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#0B0F1A"
                android:endColor="#121826"/>
        </shape>
    </item>

    <!-- SUBTLE CENTER GLOW (BLUE) -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="180dp"
                android:centerX="0.7"
                android:centerY="0.75"
                android:startColor="#3B82F6"
                android:endColor="#003B82F6"/>
        </shape>
    </item>

    <!-- SUBTLE TOP GLOW (PURPLE) -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="160dp"
                android:centerX="0.3"
                android:centerY="0.25"
                android:startColor="#8B5CF6"
                android:endColor="#008B5CF6"/>
        </shape>
    </item>

</layer-list>