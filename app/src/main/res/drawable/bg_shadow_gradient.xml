<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ===== BASE TONAL DEPTH ===== -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="1000dp"
                android:centerX="0.5"
                android:centerY="0.42"
                android:startColor="?attr/colorSurface"
                android:centerColor="?attr/colorSurfaceVariant"
                android:endColor="?android:attr/colorBackground"/>
        </shape>
    </item>

    <!-- ===== GLASS TINT ===== -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorSurface"/>
        </shape>
    </item>

    <!-- ===== ULTRA SUBTLE CENTER GLOW (FINAL FIX) ===== -->
    <item android:gravity="center">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="320dp"
                android:startColor="?attr/colorPrimaryContainer"
                android:endColor="#00000000"/>
        </shape>
    </item>

    <!-- ===== HORIZONTAL EDGE FADE ===== -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="?android:attr/colorBackground"
                android:centerColor="#00000000"
                android:endColor="?android:attr/colorBackground"/>
        </shape>
    </item>

    <!-- ===== TOP GLASS REFLECTION ===== -->
    <item android:gravity="top">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#22FFFFFF"
                android:centerColor="#08FFFFFF"
                android:endColor="#00000000"/>
        </shape>
    </item>

    <!-- ===== CENTER ACCENT LINE (SOFTENED) ===== -->
    <item
        android:width="2dp"
        android:gravity="center_horizontal">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#00000000"
                android:centerColor="?attr/colorOutline"
                android:endColor="#00000000"/>
        </shape>
    </item>

    <!-- ===== TOP VIGNETTE ===== -->
    <item android:gravity="top">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="?android:attr/colorBackground"
                android:endColor="#00000000"/>
        </shape>
    </item>

    <!-- ===== BOTTOM VIGNETTE ===== -->
    <item android:gravity="bottom">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#22000000"
                android:endColor="#00000000"/>
        </shape>
    </item>

</layer-list>